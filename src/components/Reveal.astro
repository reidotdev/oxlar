---
import Motion from "./Motion.astro";

interface Props {
  /** Seconds to delay the animation. */
  delay?: number;
  /** Pixels to rise from. */
  y?: number;
  as?: "div" | "section" | "li" | "article";
  class?: string;
}

const { delay = 0, y = 24, as: Tag = "div", class: className } = Astro.props;
---

<!-- Never wrap the LCP element: it must not wait for JS. -->
<Tag
  class={className}
  data-motion="reveal"
  data-motion-delay={delay || undefined}
  data-motion-y={y === 24 ? undefined : y}
>
  <slot />
</Tag>
<Motion />
