{
  "name": "oxlar",
  "version": "0.1.0",
  "description": "A lean, near-zero-JS Astro template for portfolio, showcase and blog sites (Sanity, GSAP, Cloudflare Workers).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint . && prettier --check . && stylelint \"src/**/*.{css,astro}\"",
    "format": "prettier --write .",
    "test": "playwright test",
    "verify:template": "node scripts/verify-template.ts",
    "sanity:types": "pnpm --filter oxlar-studio schema:extract && pnpm --filter oxlar-studio typegen",
    "perf": "node scripts/check-bundle-size.ts && node scripts/lighthouse.ts",
    "perf:size": "node scripts/check-bundle-size.ts",
    "scaffold": "node scripts/scaffold.ts",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@sanity/client": "8.9.0",
    "@sanity/image-url": "2.1.1",
    "astro": "6.4.8",
    "astro-portabletext": "1.0.1",
    "gsap": "3.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "groq": "6.17.0",
    "lighthouse": "13.5.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "satori": "0.35.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "wrangler": "4.147.0"
  }
}
