# Copy to .env and fill in. `pnpm scaffold` writes this for you.
# Write values BARE: no quotes. Hosts store the bytes they are given, quotes included.

# Canonical production URL. Required for production builds.
PUBLIC_SITE_URL=http://localhost:4321

# Sanity. Leave SANITY_PROJECT_ID empty to build with the bundled demo content.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01
# Optional. Only for private datasets and drafts (preview builds). Never commit.
SANITY_READ_TOKEN=

# Set to false to leave /styleguide out of the production build.
PUBLIC_STYLEGUIDE=true
