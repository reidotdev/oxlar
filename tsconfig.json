{
  "extends": "astro/tsconfigs/strictest",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "scripts/**/*",
    "tests/**/*",
    "*.mjs",
    "*.ts"
  ],
  "exclude": ["dist", "studio", "node_modules"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noPropertyAccessFromIndexSignature": false,
    "types": ["node"]
  }
}
