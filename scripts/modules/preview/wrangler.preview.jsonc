{
  // Same dist/, separate Worker. Protect it with Cloudflare Access.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oxlar-preview",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // `wrangler preview` (the default Previews command in Workers Builds) refuses
  // to run without this block. Empty is enough: there are no bindings.
  "previews": {},
}
