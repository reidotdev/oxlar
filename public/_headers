# Cloudflare Workers static assets / Pages format (Netlify understands it too).
# script-src and style-src live in the <meta> CSP Astro generates, because they
# need per-build hashes. These headers add what a meta tag cannot express.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin
  Cache-Control: public, max-age=0, must-revalidate

# Hashed build output never changes under the same URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Font files keep stable names, so a week rather than a year.
/fonts/*
  Cache-Control: public, max-age=604800

/og/*
  Cache-Control: public, max-age=3600
