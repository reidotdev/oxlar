{
  // Cloudflare Workers static assets. Nothing in src/ depends on this file.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oxlar",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // Workers Builds runs `npx wrangler preview` for every branch other than the
  // production one, and that command refuses to run without this block. Empty
  // is enough: a static-assets Worker has no bindings or vars to override.
  "previews": {},
}
